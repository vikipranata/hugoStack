# hugoStack environment — copy to .env and fill in.
# On first start, bootstrap turns these into /app/config.json
# (admin password + defaults); afterwards the Settings page persists
# changes into that file.

# Path to config.json inside the container (default: /app/config.json).
HUGOSTACK_CONFIG=/app/config.json

# HTTP port the server listens on (default: 8080, mapped in compose).
HUGOSTACK_PORT=8080

# Session cookie secret. Use a long random string, e.g. `openssl rand -hex 32`.
# Without it a random secret is generated per start, so logins drop on restart.
HUGOSTACK_SESSION_SECRET=

# First-run admin password (bcrypt-hashed into config.json).
HUGOSTACK_ADMIN_PASS=

# Git identity for commits made by hugoStack.
# Defaults when blank: hugoStack / hugostack@localhost.
HUGOSTACK_GIT_USER=
HUGOSTACK_GIT_EMAIL=

# Hugo repo path inside the container (default: /hugo, bind-mounted in compose).
HUGOSTACK_HUGO_PATH=/hugo
